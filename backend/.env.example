# Backend environment variables (producción: configurar en cPanel Node.js Selector)
# Base de datos MySQL (OVH CloudDB)
DB_HOST=cm1291904-002.eu.clouddb.ovh.net
DB_PORT=35996
DB_NAME=db_ferreteria
DB_USER=operario
DB_PASSWORD=__PONER_DB_PASSWORD__

# JWT (mínimo 32 caracteres, generar con: openssl rand -base64 48)
JWT_SECRET=__PONER_JWT_SECRET__
JWT_EXPIRES_IN=8h

# CORS - origen exacto del frontend
CORS_ORIGIN=http://localhost:5173

# Puerto interno (lo asigna cPanel automáticamente)
PORT=3001
NODE_ENV=production

# Azure Blob Storage (imágenes)
AZURE_BLOB_SAS_URL=https://<cuenta>.blob.core.windows.net/<container>?<sas-token>

# Opcional para Microsoft login (MSAL)
AZURE_AD_TENANT_ID=common
AZURE_AD_CLIENT_ID=d7d4dbd1-9deb-40fe-823e-5fb44f438e7d

# SMTP (opcional). Configurar en cPanel Node.js Selector; no commitear contraseñas.
SMTP_HOST=mail.cmhautomacion.com
SMTP_PORT=465
SMTP_USER=noreply@cmhautomacion.com
SMTP_PASS=__PONER_EN_CPANEL__
SMTP_SECURE=true
MAIL_FROM=noreply@cmhautomacion.com
MAIL_REPLY_TO=comercial@cmhautomacion.com
NOTIFY_EMAIL=comercial@cmhautomacion.com
MAIL_ENABLED=true
